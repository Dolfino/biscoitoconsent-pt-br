{
  "name": "centro-fashion-consent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/schema.sql', 'build/schema.sql')\"",
    "start": "node build/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:qez": "tsx scripts/qez-integration-smoke.ts",
    "test:postgres": "tsx scripts/postgres-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "playwright-core": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
