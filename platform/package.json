{
  "name": "centro-fashion-consent-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/schema.sql','build/schema.sql');fs.cpSync('src/migrations','build/migrations',{recursive:true})\"",
    "start": "node build/server.js",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "test:qez": "tsx scripts/qez-integration-smoke.ts",
    "test:postgres": "tsx scripts/postgres-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
